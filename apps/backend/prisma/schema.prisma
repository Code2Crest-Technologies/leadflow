generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  firstName         String
  lastName          String
  avatar            String?
  portalUserId      String?            @unique
  portalRole        String?
  authProvider      String?            @default("LOCAL")
  companyId         String
  role              UserRole           @default(AGENT)
  status            UserStatus         @default(ACTIVE)
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  activityLogs      ActivityLog[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  campaignTemplates CampaignTemplate[] @relation("CampaignCreator")
  conversations     Conversation[]
  deals             Deal[]             @relation("DealAssignee")
  documents         Document[]         @relation("DocumentCreator")
  documentTemplates DocumentTemplate[] @relation("DocumentTemplateCreator")
  documentVersions  DocumentVersion[]  @relation("DocumentVersionCreator")
  forms             Form[]             @relation("FormCreator")
  messages          Message[]          @relation("MessageSender")
  messageTemplates  MessageTemplate[]  @relation("TemplateCreator")
  notes             Note[]
  teamMemberships   TeamMember[]
  ownedProjects      Project[]          @relation("ProjectOwner")
  managedProjects    Project[]          @relation("ProjectManager")
  projectMemberships ProjectMember[]
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model Company {
  id                        String             @id @default(cuid())
  name                      String
  website                   String?
  industry                  String?
  logo                      String?
  portalCompanyId           String?            @unique
  subscriptionStatus        String?
  productAccess             Json?
  subscriptionExpiresAt     DateTime?
  lastPortalSyncAt          DateTime?
  gstin                     String?
  country                   String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  state                     String?
  pincode                   String?
  postalCode                String?
  phoneCountryCode          String?
  phone                     String?
  email                     String?
  logoUrl                   String?
  signatureUrl              String?
  signature                 String?
  quotationTerms            String?
  bankDetails               String?
  whatsappPhoneNumber       String?            @unique
  whatsappBusinessAccountId String?            @unique
  whatsappAccessToken       String?
  metaAdsAccountId          String?
  metaAdsAccessToken        String?
  subscriptionTier          String             @default("starter")
  maxUsers                  Int                @default(5)
  maxContacts               Int                @default(1000)
  messageTemplatesApproved  Int                @default(0)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  analyticsLogs             ActivityLog[]
  campaigns                 CampaignTemplate[]
  contacts                  Contact[]
  contactGroups             ContactGroup[]
  conversations             Conversation[]
  communicationSettings     CommunicationSettings?
  deals                     Deal[]
  documents                 Document[]
  documentTemplates         DocumentTemplate[]
  forms                     Form[]
  formSubmissions           FormSubmission[]
  publicFormTokens          PublicFormToken[]
  clientOnboardingReminders ClientOnboardingReminder[]
  integrations              Integration[]
  invoices                  Invoice[]
  billingProfiles           BillingProfile[]
  messages                  Message[]
  paymentMilestones         PaymentMilestone[]
  payments                  Payment[]
  receipts                  Receipt[]
  paymentReminderLogs       PaymentReminderLog[]
  projects                  Project[]
  quotations                Quotation[]
  tasks                     Task[]
  templates                 MessageTemplate[]
  teamMembers               TeamMember[]
  users                     User[]
  webhookEvents             WebhookEvent[]

  @@index([name])
  @@index([whatsappPhoneNumber])
}

model Contact {
  id                String         @id @default(cuid())
  phoneNumber       String
  email             String?
  firstName         String
  lastName          String?
  contactType       ContactType    @default(PERSON)
  companyName       String?
  contactPersonName String?
  phoneCountryCode  String?
  country           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?
  postalCode        String?
  gstin             String?
  taxId             String?
  phoneNormalized   String?
  whatsappOptInStatus String      @default("UNKNOWN")
  whatsappOptedInAt DateTime?
  whatsappOptedOutAt DateTime?
  whatsappOptSource String?
  avatar            String?
  companyId         String
  groupId           String?
  segment           ContactSegment @default(PROSPECT)
  status            ContactStatus  @default(ACTIVE)
  whatsappContactId String?
  metaLeadId        String?
  metaLeadData      Json?
  customFields      Json?
  lastContactedAt   DateTime?
  lastMessageAt     DateTime?
  totalSpent        Decimal        @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  activityLogs      ActivityLog[]
  formSubmissions   FormSubmission[]
  publicFormTokens  PublicFormToken[]
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group             ContactGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  documentAcceptances DocumentAcceptance[]
  deals             Deal[]
  invoices          Invoice[]
  messages          Message[]      @relation("MessageContact")
  notes             Note[]
  documents         Document[]
  projects          Project[]
  payments          Payment[]
  quotations        Quotation[]
  tasks             Task[]

  @@unique([companyId, phoneNumber])
  @@unique([companyId, phoneNormalized])
  @@index([companyId])
  @@index([groupId])
  @@index([segment])
  @@index([status])
  @@index([metaLeadId])
}

model ContactGroup {
  id        String    @id @default(cuid())
  name      String
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts  Contact[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Conversation {
  id             String             @id @default(cuid())
  contactId      String
  dealId         String?
  companyId      String
  assignedToId   String?
  channel        ConversationChannel @default(MANUAL)
  externalThreadId String?
  status         ConversationStatus @default(OPEN)
  subject        String?
  messageCount   Int                @default(0)
  unreadCount    Int                @default(0)
  lastMessageAt  DateTime?
  lastInboundAt  DateTime?
  serviceWindowEndsAt DateTime?
  resolvedAt     DateTime?
  lastAutoReplyAt DateTime?
  whatsappConvId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  activityLogs   ActivityLog[]
  assignedTo     User?              @relation(fields: [assignedToId], references: [id])
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact        Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal           Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  messages       Message[]
  notes          Note[]

  @@unique([companyId, contactId, channel])
  @@index([companyId])
  @@index([assignedToId])
  @@index([dealId])
  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  contactId         String
  conversationId    String
  senderId          String?
  companyId         String
  direction         MessageDirection @default(OUTBOUND)
  channel           ConversationChannel @default(MANUAL)
  externalMessageId String?
  messageType       MessageType      @default(TEXT)
  content           String
  mediaUrl          String?
  mediaType         String?
  whatsappMessageId String?
  whatsappStatusId  String?
  providerStatus    String?
  providerMessageId String?
  templateName      String?
  metadata          Json?
  status            MessageStatus    @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  failureCode       String?
  failureReason     String?
  templateId        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact           Contact          @relation("MessageContact", fields: [contactId], references: [id], onDelete: Cascade)
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User?            @relation("MessageSender", fields: [senderId], references: [id])

  @@index([contactId])
  @@index([conversationId])
  @@index([companyId])
  @@index([senderId])
  @@index([whatsappMessageId])
  @@index([providerMessageId])
  @@index([status])
  @@index([createdAt])
}

model MessageTemplate {
  id                   String             @id @default(cuid())
  companyId            String
  createdById          String?
  name                 String
  category             TemplateCategory   @default(GENERAL)
  content              String
  variables            String[]
  providerTemplateName String?
  header               String?
  footer               String?
  providerMetadata     Json?
  whatsappTemplateId   String?
  whatsappTemplateCode String?
  status               TemplateStatus     @default(PENDING)
  approvalMessage      String?
  language             String             @default("en")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy            User?              @relation("TemplateCreator", fields: [createdById], references: [id])
  campaigns            CampaignTemplate[] @relation("CampaignTemplateToMessageTemplate")

  @@unique([companyId, whatsappTemplateId])
  @@index([companyId])
  @@index([status])
}

model CampaignTemplate {
  id               String            @id @default(cuid())
  companyId        String
  createdById      String?
  name             String
  description      String?
  segments         String[]
  recipientCount   Int               @default(0)
  sentCount        Int               @default(0)
  scheduledFor     DateTime?
  status           CampaignStatus    @default(DRAFT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation("CampaignCreator", fields: [createdById], references: [id])
  messageTemplates MessageTemplate[] @relation("CampaignTemplateToMessageTemplate")

  @@index([companyId])
  @@index([status])
  @@index([scheduledFor])
}

model Deal {
  id           String        @id @default(cuid())
  contactId    String
  companyId    String
  assignedToId String
  title        String
  description  String?
  value        Decimal       @default(0)
  currency     String        @default("USD")
  stage        DealStage     @default(PROSPECT)
  probability  Int           @default(0)
  source       String        @default("manual")
  onboardingStatus DealOnboardingStatus @default(NOT_STARTED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  closedAt     DateTime?
  activityLogs ActivityLog[]
  formSubmissions FormSubmission[]
  publicFormTokens PublicFormToken[]
  clientOnboardingReminders ClientOnboardingReminder[]
  assignedTo   User          @relation("DealAssignee", fields: [assignedToId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  notes        Note[]
  quotations   Quotation[]
  invoices     Invoice[]
  project      Project?
  documents    Document[]
  tasks        Task[]

  @@index([contactId])
  @@index([companyId])
  @@index([assignedToId])
  @@index([stage])
  @@index([onboardingStatus])
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?
  contactId    String?
  dealId       String?
  projectId    String?
  companyId    String
  dueDate      DateTime
  status       TaskStatus @default(PENDING)
  assignedToId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedTo   User?      @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
}

model Project {
  id               String               @id @default(cuid())
  companyId        String
  dealId           String               @unique
  contactId        String
  name             String
  serviceType      String?
  status           ProjectStatus        @default(DRAFT)
  ownerId          String?
  projectManagerId String?
  startDate        DateTime?
  targetDate       DateTime?
  completedAt      DateTime?
  brief            String?
  briefData        Json?
  internalNotes    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal             Deal                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact          Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner            User?                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectManager   User?                @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  documents        Document[]
  deliverables     ProjectDeliverable[]
  invoices         Invoice[]
  milestones       ProjectMilestone[]
  paymentMilestones PaymentMilestone[]
  payments         Payment[]
  requirements     ProjectRequirement[]
  receipts         Receipt[]
  tasks            Task[]
  activityLogs     ActivityLog[]

  @@index([companyId])
  @@index([contactId])
  @@index([status])
  @@index([projectManagerId])
}

model ProjectMember {
  id         String            @id @default(cuid())
  projectId  String
  userId     String
  role       ProjectMemberRole @default(OTHER)
  assignedAt DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectDeliverable {
  id          String                   @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      ProjectDeliverableStatus @default(PENDING)
  sortOrder   Int                      @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model ProjectMilestone {
  id          String                 @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      ProjectMilestoneStatus @default(PENDING)
  targetDate  DateTime?
  completedAt DateTime?
  sortOrder   Int                    @default(0)
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model ProjectRequirement {
  id          String                   @id @default(cuid())
  projectId   String
  type        ProjectRequirementType
  label       String
  status      ProjectRequirementStatus @default(PENDING)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@index([status])
}

model DocumentTemplate {
  id               String       @id @default(cuid())
  companyId        String
  name             String
  type             DocumentType
  description      String?
  content          String
  isSystemTemplate Boolean      @default(false)
  isActive         Boolean      @default(true)
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("DocumentTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents        Document[]

  @@index([companyId])
  @@index([type])
  @@index([isActive])
}

model Document {
  id               String                @id @default(cuid())
  companyId        String
  dealId           String?
  projectId        String?
  contactId        String
  templateId       String?
  type             DocumentType
  title            String
  status           DocumentStatus        @default(DRAFT)
  currentVersionId String?
  createdById      String?
  expiresAt        DateTime?
  sentAt           DateTime?
  viewedAt         DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  supersededAt     DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal             Deal?                 @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project          Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contact          Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  template         DocumentTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy        User?                 @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  currentVersion   DocumentVersion?      @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]     @relation("DocumentVersions")
  publicTokens     DocumentPublicToken[]
  acceptances      DocumentAcceptance[]
  activityLogs     ActivityLog[]

  @@index([companyId])
  @@index([dealId])
  @@index([projectId])
  @@index([contactId])
  @@index([type])
  @@index([status])
}

model DocumentVersion {
  id              String               @id @default(cuid())
  documentId      String
  versionNumber   Int
  renderedContent String
  sourceSnapshot  Json?
  pdfPath         String?
  createdById     String?
  createdAt       DateTime             @default(now())
  document        Document             @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor      Document[]           @relation("DocumentCurrentVersion")
  createdBy       User?                @relation("DocumentVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publicTokens    DocumentPublicToken[]
  acceptances     DocumentAcceptance[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model DocumentPublicToken {
  id             String           @id @default(cuid())
  documentId     String
  versionId      String
  tokenHash      String           @unique
  expiresAt      DateTime?
  maxUses        Int?
  viewCount      Int              @default(0)
  lastViewedAt   DateTime?
  invalidatedAt  DateTime?
  createdAt      DateTime         @default(now())
  document       Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version        DocumentVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([versionId])
  @@index([expiresAt])
  @@index([invalidatedAt])
}

model DocumentAcceptance {
  id              String          @id @default(cuid())
  documentId      String
  versionId       String
  contactId       String?
  acceptedByName  String
  acceptedByEmail String
  designation     String?
  acceptanceText  String
  acceptedAt      DateTime        @default(now())
  userAgent       String?
  createdAt       DateTime        @default(now())
  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version         DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  contact         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([documentId, versionId])
  @@index([documentId])
  @@index([versionId])
}

model Form {
  id           String           @id @default(cuid())
  companyId    String
  name         String
  slug         String
  systemKey    String?
  description  String?
  status       FormStatus       @default(DRAFT)
  purpose      FormPurpose      @default(GENERAL)
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("FormCreator", fields: [createdById], references: [id])
  fields       FormField[]
  submissions  FormSubmission[]
  publicTokens PublicFormToken[]

  @@unique([companyId, slug])
  @@unique([companyId, systemKey])
  @@index([companyId])
  @@index([createdById])
  @@index([status])
  @@index([purpose])
}

model FormField {
  id          String                @id @default(cuid())
  formId      String
  key         String
  label       String
  type        FormFieldType
  placeholder String?
  helpText    String?
  required    Boolean               @default(false)
  order       Int                   @default(0)
  options     Json?
  validation  Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  form        Form                  @relation(fields: [formId], references: [id], onDelete: Cascade)
  values      FormSubmissionValue[]

  @@unique([formId, key])
  @@index([formId])
  @@index([order])
}

model FormSubmission {
  id               String               @id @default(cuid())
  formId           String
  companyId        String
  contactId        String?
  dealId           String?
  submittedByName  String?
  submittedByEmail String?
  status           FormSubmissionStatus @default(RECEIVED)
  submittedAt      DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  form             Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact          Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal             Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  values           FormSubmissionValue[]

  @@index([formId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([status])
  @@index([submittedAt])
}

model FormSubmissionValue {
  id           String         @id @default(cuid())
  submissionId String
  fieldId      String
  value        Json
  createdAt    DateTime       @default(now())
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field        FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldId])
  @@index([submissionId])
  @@index([fieldId])
}

model PublicFormToken {
  id        String    @id @default(cuid())
  formId    String
  companyId String
  contactId String?
  dealId    String?
  tokenHash String    @unique
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  form      Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([expiresAt])
  @@index([isActive])
}

model ClientOnboardingReminder {
  id                String   @id @default(cuid())
  companyId         String
  dealId            String
  contactId         String?
  publicFormTokenId String?
  reminderDay       Int
  channel           String   @default("EMAIL")
  sentAt            DateTime @default(now())
  metadata          Json?
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal              Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([companyId, dealId, reminderDay])
  @@index([companyId])
  @@index([dealId])
  @@index([sentAt])
}

model Quotation {
  id          String          @id @default(cuid())
  quoteNumber String
  contactId   String
  dealId      String?
  companyId   String
  status      QuotationStatus @default(DRAFT)
  gstPercent  Decimal         @default(0)
  paymentTerms String?        @default("On approval")
  terms       String?
  subtotal    Decimal         @default(0)
  gstAmount   Decimal         @default(0)
  total       Decimal         @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  invoices    Invoice[]
  items       QuotationItem[]

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([status])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @default(0)
  total       Decimal   @default(0)
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  quotationId   String?
  contactId     String
  dealId        String?
  projectId     String?
  companyId     String
  createdById   String?
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("INR")
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  paymentTerms  String?
  notes         String?
  terms         String?
  subtotal      Decimal       @default(0)
  discountAmount Decimal      @default(0)
  taxableAmount Decimal       @default(0)
  taxPercent    Decimal       @default(0)
  taxMode       InvoiceTaxMode @default(NONE)
  gstRegistrationStatus GstRegistrationStatus?
  cgstAmount    Decimal       @default(0)
  sgstAmount    Decimal       @default(0)
  igstAmount    Decimal       @default(0)
  taxVatAmount  Decimal       @default(0)
  taxAmount     Decimal       @default(0)
  total         Decimal       @default(0)
  totalAmount   Decimal       @default(0)
  amountPaid    Decimal       @default(0)
  balanceDue    Decimal       @default(0)
  amountDue     Decimal       @default(0)
  billingSnapshot Json?
  customerSnapshot Json?
  finalizedAt   DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  voidedAt       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal          Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotation     Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  publicTokens  InvoicePublicToken[]
  milestones    PaymentMilestone[]
  payments      Payment[]
  receipts      Receipt[]
  reminderLogs  PaymentReminderLog[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([projectId])
  @@index([quotationId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0)
  discountAmount Decimal @default(0)
  taxableAmount Decimal @default(0)
  taxRate     Decimal  @default(0)
  cgstRate    Decimal  @default(0)
  sgstRate    Decimal  @default(0)
  igstRate    Decimal  @default(0)
  taxAmount   Decimal  @default(0)
  total       Decimal  @default(0)
  totalAmount Decimal  @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model BillingProfile {
  id                 String                @id @default(cuid())
  companyId          String
  legalName          String
  gstin              String?
  gstRegistrationStatus GstRegistrationStatus @default(UNREGISTERED)
  country            String?               @default("India")
  state              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  postalCode         String?
  phoneCountryCode   String?
  phone              String?
  email              String?
  website            String?
  bankDetails        String?
  defaultPaymentTerms String?              @default("On approval")
  isDefault          Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isDefault])
}

model InvoicePublicToken {
  id         String    @id @default(cuid())
  invoiceId  String
  tokenHash  String    @unique
  expiresAt  DateTime?
  lastViewedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([expiresAt])
}

model PaymentMilestone {
  id          String                 @id @default(cuid())
  companyId   String
  projectId   String?
  invoiceId   String?
  title       String
  description String?
  percentage  Decimal?
  amount      Decimal                @default(0)
  dueDate     DateTime?
  status      PaymentMilestoneStatus @default(PENDING)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice     Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([invoiceId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  companyId         String
  invoiceId         String
  projectId         String?
  contactId         String?
  amount            Decimal       @default(0)
  currency          String        @default("INR")
  method            PaymentMethod @default(MANUAL)
  status            PaymentStatus @default(SUCCESS)
  provider          String?
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  referenceNumber   String?
  paidAt            DateTime?
  notes             String?
  metadata          Json?
  recordedById      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contact           Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  receipts          Receipt[]

  @@unique([provider, providerPaymentId])
  @@index([companyId])
  @@index([invoiceId])
  @@index([projectId])
  @@index([contactId])
  @@index([status])
}

model Receipt {
  id            String    @id @default(cuid())
  companyId     String
  invoiceId     String
  paymentId     String
  projectId     String?
  receiptNumber String
  amount        Decimal   @default(0)
  currency      String    @default("INR")
  issuedAt      DateTime  @default(now())
  pdfDownloadedAt DateTime?
  metadata      Json?
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([companyId, receiptNumber])
  @@index([companyId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([projectId])
}

model PaymentReminderLog {
  id          String   @id @default(cuid())
  companyId   String
  invoiceId   String
  reminderKey String
  channel     String   @default("MANUAL")
  sentAt      DateTime @default(now())
  metadata    Json?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, reminderKey, channel])
  @@index([companyId])
  @@index([invoiceId])
}

model Note {
  id          String   @id @default(cuid())
  content     String
  contactId   String?
  conversationId String?
  dealId      String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contact     Contact? @relation(fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  deal        Deal?    @relation(fields: [dealId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([dealId])
  @@index([conversationId])
  @@index([contactId])
  @@index([createdById])
}

model TeamMember {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  role        UserRole @default(AGENT)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model ActivityLog {
  id             String        @id @default(cuid())
  companyId      String
  eventType      String
  contactId      String?
  userId         String?
  conversationId String?
  dealId         String?
  projectId      String?
  documentId     String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact        Contact?      @relation(fields: [contactId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  deal           Deal?         @relation(fields: [dealId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  document       Document?     @relation(fields: [documentId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([contactId])
  @@index([userId])
  @@index([conversationId])
  @@index([dealId])
  @@index([projectId])
  @@index([documentId])
  @@index([eventType])
  @@index([createdAt])
}

model Integration {
  id           String    @id @default(cuid())
  companyId    String
  type         String
  name         String
  accessToken  String?
  refreshToken String?
  config       Json?
  status       String    @default("disconnected")
  provider     String?
  whatsappBusinessAccountId String?
  phoneNumberId String?
  displayPhoneNumber String?
  businessDisplayName String?
  webhookConfiguredAt DateTime?
  connectedAt  DateTime?
  disconnectedAt DateTime?
  lastWebhookAt DateTime?
  lastError     String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@unique([type, phoneNumberId])
  @@index([companyId])
  @@index([phoneNumberId])
  @@index([whatsappBusinessAccountId])
}

model CommunicationSettings {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  whatsappAssignmentStrategy String   @default("MANUAL")
  roundRobinCursorUserId     String?
  newLeadAcknowledgement     Boolean  @default(false)
  onboardingLink             Boolean  @default(false)
  onboardingReminder         Boolean  @default(false)
  documentSent               Boolean  @default(false)
  invoiceSent                Boolean  @default(false)
  paymentReminders           Boolean  @default(false)
  paymentConfirmation        Boolean  @default(false)
  projectKickoff             Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id @default(cuid())
  companyId   String?
  provider    String
  eventId     String
  eventType   String
  processedAt DateTime?
  payload     Json?
  createdAt   DateTime  @default(now())
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([companyId])
  @@index([provider])
  @@index([eventType])
}

